# Copy to .env and fill in. Required values are marked.

# REQUIRED in production - the app refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
PHYSIO_SECRET_KEY=

# "production" enforces the secret above and hides error details from clients.
PHYSIO_ENV=production

# Point these at a PERSISTENT disk. On an ephemeral filesystem every redeploy
# wipes accounts, sessions and uploaded reports.
PHYSIO_DATABASE_URL=sqlite:////data/physio.db
PHYSIO_UPLOAD_DIR=/data/uploads

# Only needed if the frontend is served from a DIFFERENT origin than the API.
# Serving both from one process (the default) needs no CORS at all.
# PHYSIO_CORS_ORIGINS=https://your-app.example.com

# How long a login stays valid.
PHYSIO_JWT_EXPIRE_HOURS=168
